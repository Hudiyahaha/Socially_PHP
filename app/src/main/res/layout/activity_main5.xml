                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/3"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:padding="6dp"
                    android:background="@drawable/oval_smd"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="15dp"
                    android:gravity="center"
                    />
            </FrameLayout>

            <!-- Post Actions -->
            <LinearLayout
                android:id="@+id/post_actions3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/post_image3"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/like" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/comment"
                    android:layout_marginStart="12dp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/jahaz"
                    android:layout_marginStart="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingRight="25dp"
                    android:gravity="center"
                    >

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/smd_circle"
                        android:layout_marginRight="5dp"
                        />
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/grey_circle"
                        android:layout_marginRight="5dp"
                        />
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/grey_circle"
                        android:layout_marginRight="5dp"
                        />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/save"
                    android:layout_marginRight="10dp"
                    />

            </LinearLayout>

            <!-- Likes Info -->
            <TextView
                android:id="@+id/post_likes3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/post_actions3"
                android:paddingStart="8dp"
                android:text="Liked by craig_love and 44,686 others"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <!-- Caption -->
            <TextView
                android:id="@+id/post_caption3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/post_likes3"
                android:paddingStart="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/black"
                android:text="joshua_l The game in Japan was amazing and I want to share some photos" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <View
        android:id="@+id/topbar_separator2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view"
        android:layout_above="@id/bottom_nav"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:id="@+id/bottom_nav"
        android:weightSum="3"
        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:weightSum="5"
        android:background="@color/white"
        android:layout_weight="1"
        >

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/home"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/search_bar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/create"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/create"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/heart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/like2"
            android:layout_weight="1"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/me"
            android:layout_weight="1"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_weight="1"
        android:background="@color/white"
        />

    </LinearLayout>

</RelativeLayout>
