<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:padding="12dp">

        <!-- Left camera icon -->
        <ImageView
            android:id="@+id/camera_icon"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:src="@drawable/camera2"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Right message icon -->
        <ImageView
            android:id="@+id/message_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/share"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

        <!-- Igtv icon left of message icon -->
        <ImageView
            android:id="@+id/igtv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/igtv"
            android:layout_toStartOf="@id/message_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp" />

        <!-- Title text centered in parent -->
        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Socially"
            android:textColor="#895955"
            android:textStyle="bold"
            android:textSize="30sp"
            android:layout_centerInParent="true" />

    </RelativeLayout>

    <View
        android:id="@+id/topbar_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view"
        android:layout_below="@id/top_bar"/>

    <ScrollView
        android:id="@+id/scroll_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_above="@id/bottom_nav"
        android:fillViewport="true">

