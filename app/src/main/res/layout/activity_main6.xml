<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:padding="12dp">

        <!-- Left icon -->
        <ImageView
            android:id="@+id/submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/search"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Right icon -->
        <ImageView
            android:id="@+id/scanner"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/scanner"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

        <!-- Middle EditText -->
        <EditText
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text"
            android:hint="Search"
            android:textColor="@color/black"
            android:textColorHint="@color/button"
            android:textStyle="bold"
            android:layout_toEndOf="@id/submit"
            android:layout_toStartOf="@id/scanner"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

    </RelativeLayout>

    <View
        android:id="@+id/topbar_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view"
        android:layout_below="@id/top_bar"/>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:id="@+id/scroll_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topbar_separator"
        android:layout_above="@id/bottom_nav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:padding="2dp"
                    android:layout_marginHorizontal="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Shop"
                        android:textColor="@color/button"
                        android:backgroundTint="@color/white"
                        app:strokeColor="@color/view"
                        app:strokeWidth="2dp"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="4dp"
                        app:iconGravity="textStart"
                        app:iconTint="@color/button"
                        />

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:text="Find Friends"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/SMD"
                        app:strokeColor="@color/view"
                        app:strokeWidth="2dp"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="4dp"
                        android:id="@+id/friends"/>

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Sports"
                        android:textColor="@color/button"
                        android:backgroundTint="@color/white"
                        app:strokeColor="@color/view"
                        app:strokeWidth="2dp"
                        app:cornerRadius="8dp"
                        />

                </LinearLayout>

            <!-- Grid of Images -->
            <LinearLayout
                android:id="@+id/image_grid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Left column (two stacked small images) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_margin="1dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ik" />

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_margin="1dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/mj" />
                    </LinearLayout>

                    <!-- Right big image (covers two rows) -->
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_height="280dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/srk" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sk" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tc2" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ha" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/srk2" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ik2" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/mj2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/meme" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/srk3" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ha2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="140dp"
                        android:layout_margin="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/dummy" />
                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <View
        android:id="@+id/topbar_separator2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view"
        android:layout_above="@id/bottom_nav"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:id="@+id/bottom_nav"
        android:weightSum="3"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:weightSum="5"
            android:background="@color/white"
            android:layout_weight="1"
            >

            <ImageView
                android:id="@+id/home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/home2"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/search2"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/create"
                android:id="@+id/create"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="24dp"
                android:id="@+id/heart"
                android:layout_height="24dp"
                android:src="@drawable/like2"
                android:layout_weight="1"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/me"
                android:layout_weight="1"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_weight="1"
            android:background="@color/white"
            />

    </LinearLayout>

</RelativeLayout>
