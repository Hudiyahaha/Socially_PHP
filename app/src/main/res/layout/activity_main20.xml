<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity20"
    android:background="@color/black"
    android:layout_margin="2dp"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        android:id="@+id/frame"
        android:layout_alignParentTop="true"
        android:layout_above="@id/activity"
        >

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/random2"
            android:scaleType="centerCrop"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="2dp"
            >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:weightSum="6"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content"
                    >
                    <View
                        android:layout_width="0dp"
                        android:layout_weight="5"
                        android:layout_height="2dp"
                        android:background="@color/white"
                        />

                    <View
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="2dp"
                        android:background="@color/time"
                        android:layout_marginEnd="3dp"
                        />

                </LinearLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"

                >

                <RelativeLayout
                    android:id="@+id/profile2_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    >

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profile2a"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/cover"
                        android:layout_alignParentStart="true"
                        />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/profile2a"
                        android:layout_marginStart="-19dp"
                        android:layout_marginTop="22dp"

                        >

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:src="@drawable/white_circle"
                            android:layout_gravity="center"
                            />

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/blue_circle"
                            android:layout_gravity="center"

                            />


                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/white_plus"
                            android:layout_gravity="center"

                            />


                    </FrameLayout>

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_toRightOf="@id/profile2_container"
                    android:layout_centerVertical="true"
                    android:layout_toLeftOf="@id/close"
                    android:gravity="center_vertical"
                    android:layout_marginStart="5dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="gursky.studio"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:layout_marginLeft="5dp"
                        />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/badge_small"
                        android:layout_marginStart="3dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4h"
                        android:textColor="@color/time"
                        android:textSize="14sp"
                        android:layout_marginLeft="5dp"
                        />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/close"
                    android:src="@drawable/close"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="5dp"
                    />

            </RelativeLayout>

        </LinearLayout>

    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:id="@+id/activity"
        android:src="@drawable/studio_bar"
        />

</RelativeLayout>