<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity21"
    android:background="@color/white"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:weightSum="8"
        android:layout_marginTop="35dp"
        android:id="@+id/top_bar"
        >

        <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/chevron_black"
            android:layout_gravity="left|center"
            android:id="@+id/exit_dm"

            />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1.5"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="3"
            android:gravity="center"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kyan.coleman"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="@color/black"

                />

            <ImageView
                android:layout_marginLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:src="@drawable/badge_blue"
                android:layout_gravity="center"
                />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1.5"
            />

        <ImageView
            android:id="@+id/options"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:src="@drawable/options"
            android:layout_gravity="center"
            />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view"
        android:layout_below="@id/top_bar"
        android:layout_marginTop="8dp"
        android:id="@+id/top_bar2"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar2"
        android:layout_above="@id/bottom_nav"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"
                >

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:id="@+id/profile"
                    >
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="94dp"
                        android:layout_height="94dp"
                        android:layout_gravity="center"
                        android:background="@drawable/gradient"
                        android:scaleType="centerCrop"
                        />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/white_circle"
                        android:layout_gravity="center"
                        />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/profile"
                        android:layout_gravity="center"
                        />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginStart="17dp"

                        >

                        <TextView
                            android:id="@+id/one"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="54"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_marginEnd="25dp"
                            />

                        <TextView
                            android:id="@+id/two"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="834"
                            android:layout_marginEnd="25dp"

                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            />

                        <TextView
                            android:id="@+id/three"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="162"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginStart="20dp"

                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/one"
                            android:text="Posts"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:layout_marginEnd="13dp"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/one"
                            android:text="Followers"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:layout_marginEnd="14dp"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/one"
                            android:text="Following"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kyan Coleman"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"

                    />

                <RelativeLayout
                    android:layout_width="115dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/oval_background"
                    android:layout_marginVertical="5dp"
                    android:gravity="center_vertical"
                    android:padding="2dp"
                    >

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/thread"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/mention"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="5dp"
                        android:layout_centerVertical="true"
                        android:layout_marginVertical="2dp"
                        />

                    <TextView
                        android:layout_toRightOf="@id/thread"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kyan.coleman"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        />

                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blogger"
                    android:textSize="13sp"
                    android:textColor="@color/time"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias "
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="2dp"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="excepturi sint occaecat... "
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginTop="2dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="more"
                        android:textSize="11sp"
                        android:textColor="@color/time"
                        android:layout_marginTop="2dp"
                        />

                </LinearLayout>

                <RelativeLayout
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/oval_background"
                    android:layout_marginVertical="5dp"
                    android:gravity="center_vertical"
                    android:padding="2dp"
                    >

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/link"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/link"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_centerVertical="true"
                        android:layout_marginVertical="2dp"
                        />

                    <TextView
                        android:layout_toRightOf="@id/link"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kyan.co"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        />

                </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    >

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/follows"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="5dp"
                        >

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            >

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Followed by "
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="your friend, another friend"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" and "
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="297 others"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            />




                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>




            <!--            BUTTONSSS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:weightSum="5">

                <RelativeLayout
                    android:id="@+id/edit_profile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_marginVertical="3dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/rounded_button"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/following"
                        android:text="Following"
                        android:textColor="@color/black"
                        android:paddingEnd="5dp"
                        android:textSize="12sp"
                        android:layout_centerInParent="true"
                        />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/chev_black"
                        android:layout_toRightOf="@id/following"
                        android:layout_centerVertical="true"
                    />

                </RelativeLayout>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="@color/bluish"
                    android:text="Message"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/time"
                    app:strokeWidth="2dp"

                    />

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="@color/bluish"
                    android:text="Email"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/time"
                    app:strokeWidth="2dp"

                    />

                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_marginVertical="4dp"
                    android:layout_weight="0.5"
                    android:background="@drawable/rounded_button"
                    android:src="@drawable/users"

                    />


            </LinearLayout>

            <!--            HIGHLIGHTSSS -->

            <LinearLayout
                android:id="@+id/stories_scroll"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_below="@id/top_bar"
                android:scrollbars="none"
                android:padding="3dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"

                >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!--First story-->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            >

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/story_circle_grey"
                                android:layout_gravity="center"
                                />

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/dummy"
                                android:layout_gravity="center"
                                />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Highlight 1"
                            android:textSize="12sp"
                            android:textColor="@color/black"

                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:id="@+id/highlight"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            >

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/story_circle_grey"
                                android:layout_gravity="center"
                                />

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/dummy"
                                android:layout_gravity="center"
                                />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Highlight 2"
                            android:textSize="12sp"
                            android:textColor="@color/black"

                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            >

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/story_circle_grey"
                                android:layout_gravity="center"
                                />

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/dummy"
                                android:layout_gravity="center"
                                />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Highlight 3"
                            android:textSize="12sp"
                            android:textColor="@color/black"

                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            >

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/story_circle_grey"
                                android:layout_gravity="center"
                                />

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/dummy"
                                android:layout_gravity="center"
                                />

                        </FrameLayout>


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Highlight 4"
                            android:textSize="12sp"
                            android:textColor="@color/black"

                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            >

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/story_circle_grey"
                                android:layout_gravity="center"
                                />

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/plus_black"
                                android:padding="10dp"
                                android:layout_gravity="center"
                                />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New"
                            android:textSize="12sp"
                            android:textColor="@color/black"
                            android:gravity="center" />

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/separator"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view"

                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginVertical="5dp"
                android:layout_gravity="center_vertical"
                >

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="15dp"
                    android:layout_weight="1"
                    android:src="@drawable/grid_black"
                    android:layout_gravity="center_vertical"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="1"
                    android:src="@drawable/tag_black"
                    android:layout_gravity="center_vertical"

                    />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/views"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:orientation="horizontal"
                >

                <View
                    android:id="@+id/topbar_separator2"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@color/black"

                    />


                <View
                    android:id="@+id/topbar_separator3"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="@color/view"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="2dp"
                android:weightSum="3"
                >

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:layout_marginEnd="2dp">

                    <ImageView
                        android:id="@+id/picture2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/coffee3"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/cameraIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Camera icon"
                        android:src="@drawable/pin" />

                </FrameLayout>


                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/moon"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/coffee2"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="2dp"
                android:weightSum="3"
                >

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/flowers"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/camram"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/gpt2"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="2dp"
                android:weightSum="3"
                >
                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/dummy"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/dummy"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/dummy"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="2dp"
                android:weightSum="3"
                >
                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/dummy"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/dummy"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="145dp"
                    android:src="@drawable/dummy"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="2dp"
                    />


            </LinearLayout>


        </LinearLayout>

    </ScrollView>

    <!--    BOTTOM THINGS -->

    <View
        android:id="@+id/topbar_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view"
        android:layout_above="@id/bottom_nav"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:id="@+id/bottom_nav"
        android:weightSum="3"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:weightSum="5"
            android:background="@color/white"
            android:layout_weight="1"
            >

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/home2"
                android:layout_weight="1"
                android:id="@+id/home"
                />

            <ImageView
                android:id="@+id/search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/search"
                android:layout_weight="1"
                />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/create"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/like2"
                android:layout_weight="1"/>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                >

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/story_circle_smd"
                    android:layout_gravity="center"
                    />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/white_circle"
                    android:layout_gravity="center"
                    />
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/dummy"
                    android:layout_gravity="center"
                    />

            </FrameLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_weight="1"
            android:background="@color/white"
            />

    </LinearLayout>

</RelativeLayout>